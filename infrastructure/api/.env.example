# ==============================================================================
# SOWFKUN VERSE GO API BACKEND ENVIRONMENT CONFIGURATION (PRODUCTION / VPC)
# ==============================================================================

# App Config
PORT=8080
API_PORT=8080
API_CONTAINER_MEMORY_LIMIT=400M
SYSTEM_BRAND_NAME="NotebookCRM"
API_SERVER=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# Security & Encryption
ENABLE_PAYLOAD_ENCRYPTION=true
RSA_PRIVATE_KEY_BASE64=""
RSA_PUBLIC_KEY_BASE64=""
JWT_SECRET="generate_a_secure_jwt_secret_key_here"
BLIND_INDEX_PEPPER="generate_a_secure_blind_index_pepper_here"
ACTIVE_ENCRYPTION_KEY_VERSION=v1
DATABASE_ENCRYPTION_KEY_v1="generate_a_32_byte_hex_key_here"

# Database (MongoDB Atlas / Self-hosted VPC Private IP)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_CONN_IDLE_TIME_MS=300000
ENABLE_ATLAS_SEARCH=true

MONGO_TENANT1_URI="mongodb://admin:mongo_root_pass_2026@192.168.1.12:27017/tenant1?authSource=admin"
MONGO_SYSTEM1_URI="mongodb://admin:mongo_root_pass_2026@192.168.1.12:27017/system1?authSource=admin"
MONGO_CONFIG1_URI="mongodb://admin:mongo_root_pass_2026@192.168.1.12:27017/config1?authSource=admin"
MONGO_LOGGING1_URI="mongodb://admin:mongo_root_pass_2026@192.168.1.12:27017/logging1?authSource=admin"
MONGO_CUSTOMER1_URI="mongodb://admin:mongo_root_pass_2026@192.168.1.12:27017/customer1?authSource=admin"
MONGO_TICKET1_URI="mongodb://admin:mongo_root_pass_2026@192.168.1.12:27017/ticket1?authSource=admin"

# Redis (VPC Private IP)
REDIS_GENERAL_POOL_SIZE=50
REDIS_GENERAL_MIN_IDLE_CONNS=5
REDIS_GENERAL_MAX_CONN_IDLE_TIME_MS=300000
REDIS_GENERAL_URL="redis://:redis_secure_pass_2026@192.168.1.11:6379/0"

REDIS_GATEWAY_POOL_SIZE=20
REDIS_GATEWAY_MIN_IDLE_CONNS=2
REDIS_GATEWAY_MAX_CONN_IDLE_TIME_MS=300000
REDIS_GATEWAY_URL="redis://:redis_secure_pass_2026@192.168.1.11:6379/1"

REDIS_JOB_POOL_SIZE=20
REDIS_JOB_MIN_IDLE_CONNS=2
REDIS_JOB_MAX_CONN_IDLE_TIME_MS=300000
REDIS_JOB1_URL="redis://:redis_secure_pass_2026@192.168.1.11:6379/2"
REDIS_JOB2_URL="redis://:redis_secure_pass_2026@192.168.1.11:6379/2"

REDIS_AGENT_BUSINESS_POOL_SIZE=20
REDIS_AGENT_BUSINESS_MIN_IDLE_CONNS=2
REDIS_AGENT_BUSINESS_MAX_CONN_IDLE_TIME_MS=300000
REDIS_AGENT_BUSINESS_URL="redis://:redis_secure_pass_2026@192.168.1.11:6379/3"

# Kafka / Redpanda (VPC Private IP)
KAFKA_DIAL_TIMEOUT_MS=10000
KAFKA_IDLE_TIMEOUT_MS=900000

KAFKA_GENERAL1_BROKERS="192.168.1.13:9092"
KAFKA_GENERAL2_BROKERS="192.168.1.13:9092"
KAFKA_ENTITY_SYNC_BROKERS="192.168.1.13:9092"

# OpenSearch (VPC Private IP)
OPENSEARCH_MAX_IDLE_CONNS=100
OPENSEARCH_MAX_IDLE_CONNS_PER_HOST=20
OPENSEARCH_IDLE_CONN_TIMEOUT_MS=90000
OPENSEARCH_LOGGING_URL="http://192.168.1.14:9200"
OPENSEARCH_CUSTOMER_ACTIVITIES_URL="http://192.168.1.14:9200"
