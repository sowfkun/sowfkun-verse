# ==============================================================================
# ON-PREMISE ALERT CONFIGURATION (/etc/infra/alert.conf)
# ==============================================================================

# Định danh tên Server hiển thị trên thông báo (VD: Redis-Server-01, API-Server-01)
SERVER_NAME="Server-01"

# --- 1. Cấu hình Telegram Alert (Khuyên dùng) ---
# Lấy token từ @BotFather và Chat ID từ @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- 2. Cấu hình Discord Webhook Alert (Tùy chọn) ---
DISCORD_WEBHOOK_URL=""

# --- 3. Ngưỡng cảnh báo (%) ---
RAM_THRESHOLD=85
SWAP_THRESHOLD=70
DISK_THRESHOLD=85
