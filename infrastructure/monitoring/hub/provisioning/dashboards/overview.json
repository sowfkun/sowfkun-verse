    {
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "⚡ CPU Usage (%) by Server",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "avg by (server) (rate(node_cpu_seconds_total{mode=~\"user|system|nice\"}[1m])) * 100",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "🧠 RAM Usage (%) by Server",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{server}}"
        }
