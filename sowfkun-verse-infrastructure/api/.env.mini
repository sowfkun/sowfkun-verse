# ==============================================================================
# SOWFKUN VERSE GO API BACKEND ENVIRONMENT CONFIGURATION (PROFILE: MINI - 1-2GB RAM)
# ==============================================================================

# ================= APP CONFIG ZONE =================
SYSTEM_BRAND_NAME="YourBrand"
APP_ENV="production"
API_SERVER=true
ENABLE_GENERAL_LOG=true
PORT=8080
API_CONTAINER_MEMORY_LIMIT=200M

# Rate Limit Config
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PUBLIC_MAX_REQUESTS=30
RATE_LIMIT_CUD_MAX_REQUESTS=30
RATE_LIMIT_AUTH_MAX_REQUESTS=20

# CORS & Payload Protection
CORS_ALLOWED_ORIGINS="http://localhost:3000"
MAX_REQUEST_BODY_SIZE_MB=2

# Security & Encryption
ENABLE_PAYLOAD_ENCRYPTION=false
RSA_PRIVATE_KEY_BASE64=""
RSA_PUBLIC_KEY_BASE64=""
JWT_SECRET="your_jwt_secret_key_minimum_32_characters_here"
BLIND_INDEX_PEPPER="your_blind_index_pepper_minimum_32_characters_here"
ACTIVE_ENCRYPTION_KEY_VERSION=v1
DATABASE_ENCRYPTION_KEY_v1="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ================= DATABASE ZONE (MongoDB Multi-Cluster) =================
MONGO_MAX_POOL_SIZE=15
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_CONN_IDLE_TIME_MS=300000

# Primary Cluster (Core Business DBs: tenant, system, config, customer, ticket)
MONGO_PRIMARY1_URI="mongodb://app_mongo:27017/?directConnection=true"

# Secondary Cluster (Auxiliary / Shard 2 DBs: logging)
MONGO_SECONDARY1_URI="mongodb://app_mongo:27017/?directConnection=true"

ENABLE_ATLAS_SEARCH=true

# ================= OPENSEARCH ZONE (Multi-Cluster) =================
OPENSEARCH_MAX_IDLE_CONNS=20
OPENSEARCH_MAX_IDLE_CONNS_PER_HOST=5
OPENSEARCH_IDLE_CONN_TIMEOUT_MS=90000

# Logging Cluster (System Logs & Danger Logs)
OPENSEARCH_LOGGING1_URL="http://app_opensearch:9200"

# Activities Cluster (Customer & User Activities)
OPENSEARCH_ACTIVITIES1_URL="http://app_opensearch:9200"

# ================= REDIS ZONE (Multi-Cluster) =================
REDIS_GENERAL_POOL_SIZE=15
REDIS_GENERAL_MIN_IDLE_CONNS=2
REDIS_GENERAL_MAX_CONN_IDLE_TIME_MS=300000

# General Redis Cluster 1 (Cache, Session, Gateway, Entity Cache)
REDIS_GENERAL1_URL="redis://:your_redis_password_here@app_redis:6379/0"

# Job Redis Cluster 1 (Asynq Background Jobs)
REDIS_JOB1_URL="redis://:your_redis_password_here@app_redis:6379/2"
ASYNQ_WORKER_CONCURRENCY=3

# ================= KAFKA ZONE (Multi-Cluster) =================
KAFKA_DEFAULT_PARTITIONS=4
KAFKA_RETENTION_DAYS=3
KAFKA_DIAL_TIMEOUT_MS=10000
KAFKA_IDLE_TIMEOUT_MS=900000

# Producer Batch Tuning (Profile: mini)
KAFKA_PRODUCER_BATCH_BYTES=65536
KAFKA_PRODUCER_BATCH_SIZE=200
KAFKA_PRODUCER_BATCH_TIMEOUT_MS=20

# General Kafka Cluster 1 (Core Business & WebSocket Events)
KAFKA_GENERAL1_BROKERS="app_kafka:9092"

# Entity Sync Kafka Cluster 1 (Change Data Capture / Sync Events)
KAFKA_ENTITY_SYNC1_BROKERS="app_kafka:9092"

# ================= MAIL ZONE =================
RESEND_ACCOUNTS='[{"api_key":"your_resend_api_key_here", "from_email":"noreply@yourdomain.com"}]'

# ================= EGRESS GATEWAY ZONE =================
EGRESS_GATEWAY_URL="http://10.30.0.2:8090"

# ================= CLOUDFLARE R2 / S3 STORAGE ZONE (Multi-Clusters Standard) =================
# General Storage Cluster 1 (R2 for Media, Avatars, Logos, Attachments)
STORAGE_GENERAL1_DRIVER="r2"
R2_GENERAL1_ACCOUNT_ID=""
R2_GENERAL1_ACCESS_KEY_ID=""
R2_GENERAL1_SECRET_ACCESS_KEY=""
R2_GENERAL1_BUCKET_NAME="your_r2_bucket_name"
R2_GENERAL1_ENDPOINT=""
R2_GENERAL1_PUBLIC_URL=""



