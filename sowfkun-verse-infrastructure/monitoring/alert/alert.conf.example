# ==============================================================================
# INFRASTRUCTURE HEALTH & ALERT CONFIGURATION (ON-PREMISE TEMPLATE)
# File location on server: /etc/infra/alert.conf
# ==============================================================================

# Node Identity
SERVER_NAME="APP-NODE-01"
SERVER_ROLE="Core Server"
SERVER_IP="127.0.0.1"

# Alert Forwarding URL (For internal private nodes to forward alerts 1-way to Egress Gateway)
# Example: ALERT_FORWARD_URL="http://10.20.0.3:8090/api/v1/system/alert/telegram"
ALERT_FORWARD_URL=""

# Telegram Bot Alerts (Direct dispatch)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Discord Webhook Alerts (Optional)
DISCORD_WEBHOOK_URL=""

# Danger Thresholds (Percentage)
CPU_THRESHOLD=85
RAM_THRESHOLD=85
SWAP_THRESHOLD=70
DISK_THRESHOLD=85

# Anti-Spam Cooldown (Seconds)
COOLDOWN_SECONDS=1800

# Periodic Report Sequencing
# Delay seconds before sending report (e.g. Server 1 = 0, Server 2 = 5, Server 3 = 10)
PERIODIC_DELAY_SECONDS=0
# Send a visual separator line after report (true for the last node, e.g. Server 3)
SEND_DIVIDER=false
